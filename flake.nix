{
  description = "NixOS VM builds and cloud infrastructure";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
    sops-nix.url = "github:Mic92/sops-nix";

    sops-nix.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs =
    inputs@{ self, nixpkgs, ... }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};

      # Workaround for fpdf2 2.8.9's Pillow-13 test failure (py-pdf/fpdf2#2085,
      # NixOS/nixpkgs#580380).  fpdf2's suite compares generated PDFs
      # byte-for-byte against test/image/image_with_explicit_dimensions.pdf, a
      # reference generated with Pillow 12.  Pillow 13 changes PNG decoding, so
      # the generated bytes (6732d6d8...) no longer match the 2.8.9 reference
      # (c7b6e70b...), checkPhase fails, and python3.13-fpdf2 stays out of
      # cache.nixos.org -- breaking every consumer (open-webui here).
      #
      # Upstream regenerated the reference for Pillow 13 (py-pdf/fpdf2#2043,
      # commit 597cfff) and shipped it in 2.9.0.  Copy that reference over the
      # 2.8.9 one while the pin still ships the old fpdf2 and Pillow 13.x so the
      # rest of the suite keeps running; the gate warns once the pin catches up
      # (fpdf2 >= 2.9.0) or nixpkgs deselects the test itself, at which point
      # this override can be deleted.
      #
      # Override python313 rather than top-level python3Packages: consumers such
      # as open-webui and ocrmypdf are defined as `with python3.pkgs`, so only
      # the interpreter's package scope propagates to them.
      extraPkgsOverlay = {
        nixpkgs.overlays = [
          (
            _final: prev:
            let
              # Reference PDF regenerated for Pillow 13 by upstream commit
              # 597cfff ("regenerate ref file for pillow 13."), shipped in 2.9.0.
              fpdf2Pillow13Reference = prev.fetchurl {
                name = "fpdf2-2.9.0-image_with_explicit_dimensions.pdf";
                url = "https://raw.githubusercontent.com/py-pdf/fpdf2/2.9.0/test/image/image_with_explicit_dimensions.pdf";
                hash = "sha256-o9qtajLWOTmMq4R5Iej5OXb5UhUoHayyP/5u884AmJU=";
              };
            in
            {
              python313 = prev.python313.override {
                packageOverrides = _pyFinal: pySuper: {
                  fpdf2 =
                    let
                      inherit (pySuper) fpdf2 pillow;
                      testName = "test_image_with_explicit_dimensions";
                    in
                    if prev.lib.versionAtLeast fpdf2.version "2.9.0" then
                      prev.lib.warn ''
                        fpdf2 ${fpdf2.version} is at or above the 2.9.0 fix line, so
                        the Pillow-13 reference workaround in flake.nix is obsolete.
                        Please remove the python313 fpdf2 override.'' fpdf2
                    else if builtins.elem testName (fpdf2.disabledTests or [ ]) then
                      prev.lib.warn ''
                        nixpkgs already deselects ${testName} in fpdf2 ${fpdf2.version},
                        so the Pillow-13 reference workaround in flake.nix is
                        redundant.  Please remove the python313 fpdf2 override.'' fpdf2
                    else if
                      prev.lib.versionAtLeast pillow.version "13"
                      && prev.lib.versionOlder pillow.version "14"
                    then
                      fpdf2.overridePythonAttrs (old: {
                        postPatch = (old.postPatch or "") + ''
                          cp ${fpdf2Pillow13Reference} test/image/image_with_explicit_dimensions.pdf
                        '';
                      })
                    else
                      # Pillow is outside the 13.x line the regenerated reference
                      # was made for; leave the package alone.
                      fpdf2;
                };
              };
            }
          )
        ];
      };
    in
    rec {
      devShells.${system}.default = import ./utils/shell.nix { inherit pkgs; };

      # VM tests: `nix build .#checks.x86_64-linux.<name> -L`
      checks.${system} = {
        wireguard = pkgs.testers.runNixOSTest ./tests/wireguard.nix;
      };

      packages.x86_64-linux = {
        default = nixosConfigurations.qemu.config.system.build.vm;
        digitalOceanImage = nixosConfigurations.digitalocean.config.system.build.digitalOceanImage;
      };

      nixosConfigurations = {
        # Local QEMU development VM
        qemu = nixpkgs.lib.nixosSystem {
          system = "x86_64-linux";
          modules = [
            extraPkgsOverlay
            "${nixpkgs}/nixos/modules/virtualisation/qemu-vm.nix"
            inputs.sops-nix.nixosModules.sops
            ./hosts/qemu
          ];
        };

        # Digital Ocean cloud image
        digitalocean = nixpkgs.lib.nixosSystem {
          system = "x86_64-linux";
          modules = [
            extraPkgsOverlay
            "${nixpkgs}/nixos/modules/virtualisation/digital-ocean-image.nix"
            inputs.sops-nix.nixosModules.sops
            ./hosts/digitalocean
          ];
        };

        digitalocean-minimum = nixpkgs.lib.nixosSystem {
          system = "x86_64-linux";
          modules = [
            extraPkgsOverlay
            "${nixpkgs}/nixos/modules/virtualisation/digital-ocean-image.nix"
            inputs.sops-nix.nixosModules.sops
            ./hosts/digitalocean/minimum
          ];
        };
      };
    };
}
